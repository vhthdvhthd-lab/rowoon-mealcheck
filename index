<!DOCTYPE html>
<html lang="ko" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>체크리스트 관리 시스템</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              navy: '#192755',
              pink: '#FD6D9A',
            }
          }
        }
      }
    }
  </script>

  <!-- React 18 and ReactDOM UMD CDN -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  
  <!-- Babel Standalone CDN for JSX -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    /* 스크롤바 숨기기 */
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

    /* --- 인쇄 전용 스타일 (인쇄시에만 작동) --- */
    @media print {
      @page {
        size: A4;
        margin: 15mm 10mm;
      }
      body {
        background-color: white !important;
        color: black !important;
        -webkit-print-color-adjust: exact;
      }
      /* 화면 전용 요소 숨기기 */
      .no-print, 
      header, 
      nav, 
      button, 
      select, 
      .quick-selector,
      input::placeholder {
        display: none !important;
      }
      /* 인쇄 시 텍스트로 대체 표시 */
      .print-text-only {
        display: block !important;
        font-weight: bold;
      }
      /* 인쇄 시 배경색 및 그림자 제거 */
      .shadow-md, .shadow-xl, .rounded-2xl {
        box-shadow: none !important;
        border-radius: 0 !important;
      }
      /* 표 스타일 최적화 */
      table {
        border-collapse: collapse !important;
        width: 100% !important;
        border: 1.5px solid black !important;
      }
      th, td {
        border: 1px solid #000 !important;
        padding: 6px 2px !important;
        color: black !important;
        background: transparent !important;
      }
      th {
        background-color: #f3f4f6 !important;
      }
      /* 텍스트 입력창 처리 */
      textarea, input {
        border: none !important;
        padding: 0 !important;
        width: 100% !important;
        resize: none !important;
        background: transparent !important;
      }
      /* 제목 및 레이아웃 */
      .print-title {
        display: block !important;
        text-align: center;
        margin-bottom: 20px;
      }
    }
    
    /* 화면용 보조 클래스 */
    .print-only { display: none; }
  </style>
</head>
<body class="h-full bg-slate-100 text-slate-800 antialiased selection:bg-rose-500 selection:text-white">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo } = React;

    // --- 아이콘 (화면용) ---
    const IconCalendar = () => <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>;
    const IconPrinter = () => <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>;

    // --- 데이터 시드 ---
    const INITIAL_ACCOUNTS = [{ code: '00', name: '관리자', role: 'admin', teacherName: '전체' }];
    const INITIAL_FACILITY_INFO = { name: '로운주간이용센터', phone: '02-1234-5678' };
    const INITIAL_PARTICIPANTS = [
      { id: '1', name: '강승희', teacher: '김선생님', order: 1 },
      { id: '2', name: '강주연', teacher: '김선생님', order: 2 },
      { id: '3', name: '김도현', teacher: '박선생님', order: 3 },
    ];
    const PERSONAL_ACTIVITIES = [
      { key: 'study', label: '개별학습' },
      { key: 'tv', label: 'TV시청' },
      { key: 'fineMotor', label: '소근육' },
      { key: 'creation', label: '창작' },
      { key: 'other', label: '기타' }
    ];

    function App() {
      const [currentAccount, setCurrentAccount] = useState({ code: '00', name: '관리자', role: 'admin' });
      const [facilityInfo] = useState(INITIAL_FACILITY_INFO);
      const [participants, setParticipants] = useState(INITIAL_PARTICIPANTS);
      const [selectedParticipantId, setSelectedParticipantId] = useState('1');
      const [year, setYear] = useState(2024);
      const [month, setMonth] = useState(8);
      const [checklistData, setChecklistData] = useState({});

      const currentParticipant = participants.find(p => p.id === selectedParticipantId) || participants[0];
      const monthKey = `${year}-${String(month).padStart(2, '0')}`;
      const currentMonthRecord = checklistData[selectedParticipantId]?.[monthKey] || { days: {}, integratedPersonalNote: '', integratedDailyNote: '' };

      const monthDays = useMemo(() => {
        const daysInMonth = new Date(year, month, 0).getDate();
        const daysArr = [];
        const dayNames = ['일', '월', '화', '수', '목', '금', '토'];
        for (let d = 1; d <= daysInMonth; d++) {
          const dateObj = new Date(year, month - 1, d);
          const dayOfWeek = dateObj.getDay();
          if (dayOfWeek !== 0 && dayOfWeek !== 6) { // 평일만 표시
            daysArr.push({ day: d, dateKey: `${year}-${String(month).padStart(2, '0')}-${String(d).padStart(2, '0')}`, dayName: dayNames[dayOfWeek] });
          }
        }
        return daysArr;
      }, [year, month]);

      const toggleCheck = (dateKey, actKey) => {
        setChecklistData(prev => {
          const pData = prev[selectedParticipantId] || {};
          const mData = pData[monthKey] || { days: {} };
          const dayObj = mData.days[dateKey] || { personal: {} };
          return {
            ...prev,
            [selectedParticipantId]: {
              ...pData,
              [monthKey]: {
                ...mData,
                days: { ...mData.days, [dateKey]: { ...dayObj, personal: { ...dayObj.personal, [actKey]: !dayObj.personal[actKey] } } }
              }
            }
          };
        });
      };

      const setNote = (val) => {
        setChecklistData(prev => ({
          ...prev,
          [selectedParticipantId]: {
            ...prev[selectedParticipantId],
            [monthKey]: { ...currentMonthRecord, integratedPersonalNote: val }
          }
        }));
      };

      return (
        <div className="min-h-screen">
          {/* [화면 전용 헤더] */}
          <header className="bg-[#192755] text-white p-4 flex justify-between items-center no-print">
            <h1 className="font-bold">{facilityInfo.name}</h1>
            <div className="flex gap-4 items-center">
              <span className="text-sm">{currentAccount.name}님</span>
              <button onClick={() => window.print()} className="bg-[#FD6D9A] px-4 py-1.5 rounded-lg flex items-center gap-2 font-bold">
                <IconPrinter /> 인쇄하기
              </button>
            </div>
          </header>

          {/* [인쇄 전용 제목] - 화면에선 숨겨짐 */}
          <div className="print-only print-title">
            <h1 className="text-3xl font-black">{facilityInfo.name} 개인지원 체크리스트</h1>
            <div className="flex justify-center gap-10 mt-4 text-lg border-b-2 border-black pb-2">
              <span><b>이용인명:</b> {currentParticipant.name}</span>
              <span><b>기간:</b> {year}년 {month}월</span>
            </div>
          </div>

          <main className="max-w-7xl mx-auto p-4 sm:p-6">
            
            {/* [화면 전용 선택바] */}
            <div className="no-print bg-white p-4 rounded-xl shadow-sm mb-6 flex gap-4 overflow-x-auto">
              {participants.map(p => (
                <button
                  key={p.id}
                  onClick={() => setSelectedParticipantId(p.id)}
                  className={`px-4 py-2 rounded-lg font-bold shrink-0 ${selectedParticipantId === p.id ? 'bg-[#192755] text-white' : 'bg-slate-200'}`}
                >
                  {p.name}
                </button>
              ))}
            </div>

            <div className="bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200">
              <div className="bg-[#192755] text-white p-4 no-print flex justify-between items-center">
                <h2 className="font-bold text-lg">{currentParticipant.name} 이용인 - {month}월 기록</h2>
                <div className="text-sm">※ 평일 기준 출력됩니다.</div>
              </div>

              {/* [표 영역] */}
              <div className="overflow-x-auto">
                <table className="w-full text-center">
                  <thead>
                    <tr className="bg-slate-100 text-slate-700 font-bold">
                      <th className="w-16">날짜</th>
                      <th className="w-16">요일</th>
                      <th className="w-24">상태</th>
                      {PERSONAL_ACTIVITIES.map(act => <th key={act.key}>{act.label}</th>)}
                      <th className="no-print">비고</th>
                    </tr>
                  </thead>
                  <tbody>
                    {monthDays.map(d => {
                      const dayData = currentMonthRecord.days[d.dateKey] || { status: '등원', personal: {} };
                      return (
                        <tr key={d.dateKey} className="hover:bg-slate-50 transition">
                          <td className="font-bold py-3">{d.day}</td>
                          <td>{d.dayName}</td>
                          <td>
                            <select 
                              value={dayData.status} 
                              onChange={() => {}} // 샘플용
                              className="no-print bg-slate-100 rounded px-1 text-xs"
                            >
                              <option>등원</option>
                              <option>결석</option>
                            </select>
                            <span className="print-only">{dayData.status || '등원'}</span>
                          </td>
                          {PERSONAL_ACTIVITIES.map(act => (
                            <td key={act.key} className="p-0">
                              <button 
                                onClick={() => toggleCheck(d.dateKey, act.key)}
                                className={`w-full h-full py-3 no-print ${dayData.personal?.[act.key] ? 'text-pink-500 font-bold' : 'text-slate-300'}`}
                              >
                                {dayData.personal?.[act.key] ? 'V' : '-'}
                              </button>
                              <span className="print-only">{dayData.personal?.[act.key] ? 'V' : ''}</span>
                            </td>
                          ))}
                          <td className="no-print">
                            <input type="text" className="w-full text-xs text-slate-400 px-2" placeholder="메모" />
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>

              {/* [종합 의견] */}
              <div className="p-6 border-t border-slate-200">
                <h3 className="font-bold text-[#192755] mb-4 flex items-center gap-2">
                  <span className="no-print">📝</span> 
                  {month}월 개인지원 종합 의견 (활동 총평)
                </h3>
                <textarea
                  className="w-full p-4 rounded-xl border border-slate-200 min-h-[150px] focus:ring-2 focus:ring-pink-500 outline-none"
                  placeholder="인쇄 시 이 내용은 표 아래에 그대로 출력됩니다."
                  value={currentMonthRecord.integratedPersonalNote}
                  onChange={(e) => setNote(e.target.value)}
                />
              </div>
            </div>

            {/* [인쇄 시 하단 정보] */}
            <div className="print-only text-right mt-10 text-sm font-bold">
              <p>로운주간이용센터 담당자: ________________ (서명)</p>
            </div>

          </main>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
